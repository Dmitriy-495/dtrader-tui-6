# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git — этот репозиторий публичный
# (см. раздел 4 CHECKPOINT.md dtrader-6).

# Полный адрес ws-server, включая путь /ws.
# msk и sgp — два независимых боевых сервера, выберите один.
WS_SERVER_URL=ws://<host>:9000/ws

# Должен совпадать с WS_API_KEY на выбранном сервере
# (~/dtrader-6/shared/config/ws-server.env на msk/sgp).
WS_API_KEY=

# Опционально, не используется в MVP (нет новостного модуля пока).
CRYPTOPANIC_API_KEY=
